{
  "name": "jungle-wagering",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Wagering Processor - Jungle Gaming backend challenge",
  "scripts": {
    "start": "bun run src/main.ts",
    "migration:up": "bun run src/infrastructure/database/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test:load": "bun run load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "6.6.18",
    "@mikro-orm/migrations": "6.6.18",
    "@mikro-orm/postgresql": "6.6.18",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
